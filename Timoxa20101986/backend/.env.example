# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Порт бэкенда
PORT=3002

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173
# Set to true when the public site is served over HTTPS.
COOKIE_SECURE=false
NODE_ENV=development
# Optional public website URL. Set only after deploying to a real HTTPS domain.
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=Instalead

# Токен Телеграм-бота от @BotFather.
# Пусто — бот не запускается, платформа работает как обычно, только через веб.
# Никогда не коммитьте реальный токен: любой, кто его увидит, получит полный
# контроль над ботом и над всеми привязанными к нему аккаунтами.
TELEGRAM_BOT_TOKEN=

# Прокси для Телеграма. Нужен, если api.telegram.org недоступен из вашей сети.
# Поддерживаются socks5://user:pass@host:port и http://user:pass@host:port
# Если не задан, используется SOCKS5_PROXY (если он есть).
TELEGRAM_PROXY=

# Альтернатива прокси: свой или зеркальный Bot API сервер.
# По умолчанию https://api.telegram.org
TELEGRAM_API_ROOT=
