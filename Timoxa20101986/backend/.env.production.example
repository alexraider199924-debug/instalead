# Production backend settings for Yandex Cloud VM
PORT=3002
NODE_ENV=production
CORS_ORIGINS=https://YOUR_DOMAIN
COOKIE_SECURE=true

OPENROUTER_SITE_URL=https://YOUR_DOMAIN
OPENROUTER_APP_TITLE=Instalead

# Optional Telegram integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY=
TELEGRAM_API_ROOT=

# Keep API keys in the app settings or a secret manager; never commit them.
